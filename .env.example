# Local Docker Compose configuration. Copy to .env to override defaults.
FE_PORT=8080
BE_PORT=8000
POSTGRES_DB=socratic
POSTGRES_USER=socratic
# Local development only. Set your own password before using shared infrastructure.
POSTGRES_PASSWORD=socratic_local_only
# Generate a private signing key. Never commit the real value.
JWT_SECRET=
# Adaptive Socratic tutor.
TUTOR_MODE=openai
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-6.1-sol
OPENAI_ASSESSMENT_MODEL=gpt-6.1-sol
# OpenAI reads images and documents. No Gemini credential is needed.
DOCUMENT_AI_PROVIDER=openai
DOCUMENT_AI_MODEL=gpt-5-mini
# false for local HTTP; use true with HTTPS outside local.
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
# Compose computes trusted local origins from FE_PORT/BE_PORT by default.
# Override this for an HTTPS domain:
# AUTH_ALLOWED_ORIGINS=https://your-domain.example
# Origins are computed by Compose for local ports unless overridden.
# AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8000
