# Production reference: inject through Northflank runtime Secret Groups.
# API, worker and migrate use process variables. This file is not auto-loaded.
# Development loads only the repository-root .env; production loads no .env.
APP_ENV=production
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
AUTO_MIGRATE=false
BACKGROUND_JOBS=true
STORAGE_PATH=/app/storage
# Image default is api for compatibility. Northflank socratic-api uses combined.
RUN_MODE=combined
SHUTDOWN_GRACE_SECONDS=120

# API only: stable private key containing at least 32 random bytes.
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SIGNING_KEY
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=604800
AUTH_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN.invalid
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN.invalid
# Staging without verified ingress ranges: ignore all forwarded IP/scheme headers.
TRUST_PROXY_HEADERS=false
# Canonical browser-facing origin for HTTPS redirects/URL generation through /api rewrite.
PUBLIC_API_ORIGIN=https://YOUR-FRONTEND-DOMAIN.invalid
# Only when TRUST_PROXY_HEADERS=true: set verified proxy IPs/CIDRs; never * or /0.
# FORWARDED_ALLOW_IPS=
# Authentication site-wide attempts per 15 minutes, shared by all peers/accounts.
AUTH_LOGIN_GLOBAL_LIMIT=300
AUTH_REGISTER_GLOBAL_LIMIT=60

# Existing Responses/Structured Outputs models; API only.
TUTOR_MODE=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_PROJECT_KEY
OPENAI_TUTOR_MODEL=gpt-6.1-sol
OPENAI_ASSESSMENT_MODEL=gpt-6.1-sol
DOCUMENT_AI_PROVIDER=openai
DOCUMENT_AI_MODEL=gpt-6.1-sol
# Optional second vision pass: detect graphs/diagrams/tables and their page regions.
# This adds model calls and cost; leave off until a document set has been evaluated.
DOCUMENT_VISUAL_ANALYSIS=0
DOCUMENT_VISUAL_MAX_SOURCES=30
AI_REQUESTS_PER_HOUR=60
UPLOADS_PER_HOUR=20

DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
LOG_LEVEL=INFO
# Worker parser; combined inherits these settings. Platform termination: 150s.
WORKER_JOB_TIMEOUT_SECONDS=300
DOCUMENT_AI_TIMEOUT_SECONDS=60
WORKER_PARSER_MEMORY_MB=256

# Local alternative: APP_ENV=development, AUTH_COOKIE_SECURE=false,
# DATABASE_URL unset (SQLite), AUTO_MIGRATE=true, BACKGROUND_JOBS=false,
# and HTTP origins matching the local frontend. See the root .env.example.
