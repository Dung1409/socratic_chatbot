# Environment variables are read from the process. No API key is required in template mode.
# DATABASE_PATH=D:/ENSOAI/socratic_chatbot/backend/data/socratic.db
# PostgreSQL takes priority over DATABASE_PATH when configured.
# DATABASE_URL=postgresql://socratic:password@127.0.0.1:5432/socratic
# Enable durable extraction jobs only when a worker is running.
BACKGROUND_JOBS=false
# STORAGE_PATH=D:/ENSOAI/socratic_chatbot/backend/data/uploads
# AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
