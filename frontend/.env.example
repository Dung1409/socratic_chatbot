# Keep empty on Vercel: production always calls /api on the same origin.
# Set the real backend HTTPS URL in frontend/vercel.json, not in this variable.
# Development-only override: an origin without the /api suffix.
VITE_API_URL=
# Local Vite dev proxy only; not a Vercel environment variable.
# API_PROXY_TARGET=http://127.0.0.1:8000
